       fhir:sliceName [ fhir:v "siblingBirthOrder" ] ;
       fhir:short [ fhir:v "同胞内出生順（整数）" ] ;
       fhir:definition [ fhir:v "同胞内の出生順を表す数値。家族歴の聴取が不完全で年齢または生年月日が不明な場合に、出生順（1、2、3…）を表現するために用いる。" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
