  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Extension" ] ;
       fhir:path [ fhir:v "Extension" ] ;
       fhir:short [ fhir:v "同胞内出生順" ] ;
       fhir:definition [ fhir:v "FamilyMemberHistoryのrelationship（続柄）と組み合わせて、関連する家族構成員の同胞内出生順と性別同胞内出生順名称を表現する拡張。同胞内の順位を整数で、性別の同胞内の出生順の名称（長男、長女、次男、次女など）をCodeableConceptで表現する。日常の臨床では家族の氏名は聴取されずに続柄で記述され、また、関係者全員の生年月日や年齢を聴取できない場合が多いことを想定している。また、遺伝学的血統図は対象外である。本実装ガイド（Version 1.2.0）の範囲外であるが、 参考として[Genetic Pedigreeプロファイル](https://hl7.org/fhir/R4/familymemberhistory-genetic.html)を参照すること。" ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrder" ] ;
       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:sliceName [ fhir:v "siblingBirthOrder" ] ;
       fhir:short [ fhir:v "同胞内出生順（整数）" ] ;
       fhir:definition [ fhir:v "同胞内の出生順を表す数値。家族歴の聴取が不完全で年齢または生年月日が不明な場合に、出生順（1、2、3…）を表現するために用いる。" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrder.extension" ] ;
       fhir:path [ fhir:v "Extension.extension.extension" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrder.url" ] ;
       fhir:path [ fhir:v "Extension.extension.url" ] ;
       fhir:fixed [
         a fhir:Uri ;
         fhir:v "siblingBirthOrder"^^xsd:anyURI ;
         fhir:l fhir:siblingBirthOrder
       ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrder.value[x]" ] ;
       fhir:path [ fhir:v "Extension.extension.value[x]" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "integer"^^xsd:anyURI ;
           fhir:l fhir:integer
         ]
       ] ) ;
       fhir:minValue [
         a fhir:Integer ;
         fhir:v 1
       ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrderByGender" ] ;
       fhir:path [ fhir:v "Extension.extension" ] ;
       fhir:sliceName [ fhir:v "siblingBirthOrderByGender" ] ;
       fhir:short [ fhir:v "性別同胞内出生順名称（コード値）" ] ;
       fhir:definition [ fhir:v "同胞内の出生順を、性別を考慮した呼称（例：長男、長女、次男、次女）で表す。国際化対応の対応のため、designation により対象者の出身国の用語を追加定義できる。" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrderByGender.extension" ] ;
       fhir:path [ fhir:v "Extension.extension.extension" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrderByGender.url" ] ;
       fhir:path [ fhir:v "Extension.extension.url" ] ;
       fhir:fixed [
         a fhir:Uri ;
         fhir:v "siblingBirthOrderByGender"^^xsd:anyURI ;
         fhir:l fhir:siblingBirthOrderByGender
       ]
     ] [
       fhir:id [ fhir:v "Extension.extension:siblingBirthOrderByGender.value[x]" ] ;
       fhir:path [ fhir:v "Extension.extension.value[x]" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "CodeableConcept"^^xsd:anyURI ;
           fhir:l fhir:CodeableConcept
         ]
       ] ) ;
       fhir:binding [
         fhir:strength [ fhir:v "preferred" ] ;
         fhir:valueSet [
           fhir:v "http://jpfhir.jp/fhir/core/ValueSet/JP_SiblingBirthOrderByGender_VS"^^xsd:anyURI ;
           fhir:l <http://jpfhir.jp/fhir/core/ValueSet/JP_SiblingBirthOrderByGender_VS>
         ]
       ]
     ] [
