       fhir:definition [ fhir:v "リソースのURLで使用される論理ID。一度割り当てられたら、この値は変更されません。" ] ;
       fhir:comment [ fhir:v "リソースにIDがないのは、作成操作を使用してサーバーに送信されているときだけです。" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
