       fhir:short [ fhir:v "working | snapshot | changes" ] ;
       fhir:definition [ fhir:v "エントリーリストの作成方法 – それが継続的に維持されるのに適した作業リスト(working)であるか、別のソースからのアイテムのリストのスナップショット(snapshot)を表すか、またはアイテムが追加、変更、削除されることができる作成済みのリスト(changes)であるかを示す。" ] ;
       fhir:comment [ fhir:v "「変更リストが完全なリストと誤解されることを防ぐため、この要素は修飾子としてラベル付けされます。」" ] ;
       fhir:requirements [ fhir:v "Sections are used in various ways, and it must be known in what way it is safe to use the entries in them." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
