     fhir:element ( [
       fhir:code [ fhir:v "D" ] ;
       fhir:display [ fhir:v "死亡" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "O" ] ;
         fhir:display [ fhir:v "その他" ] ;
         fhir:equivalence [ fhir:v "inexact" ] ;
         fhir:comment [ fhir:v "JHSD0006 に死亡に直接対応するコードがないため「その他」にマップ。レセプト電算転帰の #3（死亡）との組み合わせ使用を推奨。" ]
       ] )
     ] [
       fhir:code [ fhir:v "R" ] ;
       fhir:display [ fhir:v "回復" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "M" ] ;
         fhir:display [ fhir:v "寛解" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "「寛解（M）」は症状の軽減・消失を示し、「回復（R）」の一側面に相当するが、完全回復（F）は寛解の上位概念ではないため wider。" ]
       ] )
     ] [
       fhir:code [ fhir:v "N" ] ;
       fhir:display [ fhir:v "回復せず／変わらない" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "C" ] ;
         fhir:display [ fhir:v "継続" ] ;
         fhir:equivalence [ fhir:v "wider" ] ;
         fhir:comment [ fhir:v "「継続（C）」は治療継続中を示し、変わらない状態に相当するが、悪化（W）も継続に包含されるため wider。" ]
       ] )
     ] [
       fhir:code [ fhir:v "W" ] ;
       fhir:display [ fhir:v "悪化" ] ;
       fhir:target ( [
         fhir:code [ fhir:v "C" ] ;
         fhir:display [ fhir:v "継続" ] ;
         fhir:equivalence [ fhir:v "inexact" ] ;
         fhir:comment [ fhir:v "JHSD0006 に悪化の直接対応コードがないため「継続」にマップ。情報が失われるため、悪化状態の記録にはレセプト電算転帰または SNOMED CT マッピングを推奨。" ]
       ] )
