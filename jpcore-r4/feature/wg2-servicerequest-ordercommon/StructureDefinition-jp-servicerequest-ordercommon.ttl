       fhir:definition [ fhir:v "リクエストを開始し、その有効化に責任を持つ個人。\n\n【JP Core】【JP Core】本プロファイルでは「依頼者」を記述する。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.reasonCode" ] ;
       fhir:path [ fhir:v "ServiceRequest.reasonCode" ] ;
       fhir:short [ fhir:v "行為やサービスの説明・理由（【JP Core】検査目的、依頼病名）" ] ;
       fhir:definition [ fhir:v "このサービスがリクエストされる理由についての説明または根拠をコード化またはテキスト化したもの。しばしば（保険）請求を目的とされる。supportingInfoで参照されるリソースに関連する場合がある。\n\n本プロファイルでは「検査目的」および「依頼病名」を記述できる。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.reasonReference" ] ;
       fhir:path [ fhir:v "ServiceRequest.reasonReference" ] ;
       fhir:short [ fhir:v "行為やサービスの説明・理由（参照）（【JP Core】依頼病名Condition）" ] ;
       fhir:definition [ fhir:v "このサービスが要求される理由の正当性を提供する他のリソースを示す。supportingInfoで参照されるリソースに関連する場合がある。\n\n【JP Core】本プロファイルではConditionリソースとして表された「依頼病名」を参照できる。" ]
     ] [
