           ]
         ] ) ;
         fhir:code [
           fhir:v "http://hl7.org/fhirpath/System.String"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhirpath/System.String>
         ]
       ] ) ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta" ] ;
       fhir:short [ fhir:v "リソースに関するMetadata" ] ;
       fhir:definition [ fhir:v "リソースに関するMetadata。これはインフラストラクチャによって維持されるコンテンツです。 コンテンツの変更は、リソースのバージョン変更と常に関連しているわけではありません。" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "Resource.meta" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Meta"^^xsd:anyURI ;
           fhir:l fhir:Meta
         ]
       ] ) ;
       fhir:constraint ( [
         fhir:key [ fhir:v "ele-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "すべてのFHIR要素は、@valueまたはchildrenを持っている必要があります。" ] ;
         fhir:expression [ fhir:v "hasValue() or (children().count() > id.count())" ] ;
         fhir:xpath [ fhir:v "@value|f:*|h:div" ] ;
