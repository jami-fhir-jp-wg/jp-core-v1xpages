         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "もしリソースが他のリソースに含まれている場合、そのリソースにはネストされたリソースを含めてはなりません (moshi risōsu ga hoka no risōsu ni fukumarete iru baai, sono risōsu ni wa nesuto sareta risōsu o fukumete wa narimasen)." ] ;
         fhir:expression [ fhir:v "contained.contained.empty()" ] ;
         fhir:xpath [ fhir:v "not(parent::f:contained and f:contained)" ] ;
         fhir:source [
