     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient PatientCervicalCytology</b></p><a name=\"PatientCervicalCytology\"> </a><a name=\"hcPatientCervicalCytology\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-jp-patient.html\">JP Core Patient Profile</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">由美 高橋  Female, DoB: 1980-11-25 ( 56789012)</p><hr/></div>"^^rdf:XMLLiteral
