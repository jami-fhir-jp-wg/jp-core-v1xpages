       fhir:short [ fhir:v "患者、消費者向けの説明" ] ;
       fhir:definition [ fhir:v "患者または消費者が理解できる言葉で指示。" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:base [
         fhir:path [ fhir:v "ServiceRequest.patientInstruction" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "1" ]
       ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "string"^^xsd:anyURI ;
           fhir:l fhir:string
         ]
       ] ) ;
       fhir:constraint ( [
         fhir:key [ fhir:v "ele-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "すべてのFHIR要素は、@valueまたはchildrenを持っている必要があります。" ] ;
         fhir:expression [ fhir:v "hasValue() or (children().count() > id.count())" ] ;
         fhir:xpath [ fhir:v "@value|f:*|h:div" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Element"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Element>
         ]
       ] ) ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "v2" ] ;
         fhir:map [ fhir:v "NTE" ]
       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v ".text" ]
       ] )
     ] [
       fhir:id [ fhir:v "ServiceRequest.relevantHistory" ] ;
       fhir:path [ fhir:v "ServiceRequest.relevantHistory" ] ;
       fhir:short [ fhir:v "リソースの履歴（バージョン管理）" ] ;
       fhir:definition [ fhir:v "このリクエストの履歴で重要なもの" ] ;
       fhir:comment [ fhir:v "この要素はには、ServiceRequestのProvenanceの全てのバージョンではなく、重要と思われたものだけ含められる。現在のバージョンのリソースに関連したProvenanceリソースを含めてはならない（SHALL NOT）。（もし、Provenanceとして重要な変化と思われれば、以降の更新の一部として追加すべきである。それまでは、'_revinclude'を使って指定されたProvenanceのバージョンを直接クエリーできる。全てのProvenanceはこのRequestの履歴を対象とすべきである。）" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:base [
         fhir:path [ fhir:v "ServiceRequest.relevantHistory" ] ;
         fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
         fhir:max [ fhir:v "*" ]
       ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Reference"^^xsd:anyURI ;
           fhir:l fhir:Reference
         ] ;
         fhir:targetProfile ( [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Provenance|4.0.1"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Provenance?version=4.0.1>
         ] )
       ] ) ;
       fhir:constraint ( [
         fhir:key [ fhir:v "ele-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "すべてのFHIR要素は、@valueまたはchildrenを持っている必要があります。" ] ;
         fhir:expression [ fhir:v "hasValue() or (children().count() > id.count())" ] ;
         fhir:xpath [ fhir:v "@value|f:*|h:div" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Element"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Element>
         ]
       ] ) ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v false ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "workflow" ] ;
         fhir:map [ fhir:v "Request.relevantHistory" ]
       ] [
         fhir:identity [ fhir:v "v2" ] ;
         fhir:map [ fhir:v "N/A" ]
       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v ".inboundRelationship(typeCode=SUBJ].source[classCode=CACT, moodCode=EVN]" ]
       ] )
     ] )
  ] ; # 
  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "ServiceRequest" ] ;
       fhir:path [ fhir:v "ServiceRequest" ] ;
       fhir:short [ fhir:v "検体検査の個別検査項目【詳細参照】" ] ;
       fhir:definition [ fhir:v "検体検査の依頼に含まれる、個々の検査項目のサービスリクエスト。" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】このプロファイルは検体検査を対象とする。\n検査項目の粒度は、結果として返される Observation（JP_Observation_LabResult）と同じ JLAC の検査項目単位とする。複数の検査項目をまとめた依頼単位（セットオーダ、パネルオーダ）は JP_ServiceRequest_OrderRequesting プロファイル（追加予定）で表現する。\nJP Core では、依頼単位と個別検査項目との関係付けの方法を規定しない。関係付けが必要な場合は、本プロファイルを継承する個別仕様（ユースケースごとの実装ガイド）で定義する。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.id" ] ;
       fhir:path [ fhir:v "ServiceRequest.id" ] ;
       fhir:short [ fhir:v "論理ID" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta" ] ;
       fhir:short [ fhir:v "リソースに関するメタデータ" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta.id" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta.id" ] ;
       fhir:short [ fhir:v "要素間参照のための一意なID" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta.versionId" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta.versionId" ] ;
       fhir:short [ fhir:v "バージョン固有の識別子" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta.lastUpdated" ] ;
       fhir:short [ fhir:v "リソースのバージョンが最後に変更された日時" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta.source" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta.source" ] ;
       fhir:short [ fhir:v "リソースの出所" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta.profile" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta.profile" ] ;
       fhir:short [ fhir:v "準拠を宣言するプロファイル" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta.security" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta.security" ] ;
       fhir:short [ fhir:v "リソースに適用されるセキュリティラベル" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.meta.tag" ] ;
       fhir:path [ fhir:v "ServiceRequest.meta.tag" ] ;
       fhir:short [ fhir:v "リソースに適用されるタグ" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.implicitRules" ] ;
       fhir:path [ fhir:v "ServiceRequest.implicitRules" ] ;
       fhir:short [ fhir:v "このコンテンツが作成されたルールのセット" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.text" ] ;
       fhir:path [ fhir:v "ServiceRequest.text" ] ;
       fhir:short [ fhir:v "このリソースを人間が解釈するためのテキスト要約" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.contained" ] ;
       fhir:path [ fhir:v "ServiceRequest.contained" ] ;
       fhir:short [ fhir:v "インラインリソース" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.modifierExtension" ] ;
       fhir:path [ fhir:v "ServiceRequest.modifierExtension" ] ;
       fhir:short [ fhir:v "無視できない拡張" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.identifier" ] ;
       fhir:path [ fhir:v "ServiceRequest.identifier" ] ;
       fhir:short [ fhir:v "個別検査項目の業務ID【詳細参照】" ] ;
       fhir:definition [ fhir:v "個別検査項目に割り当てられた識別子。" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】このプロファイルでは必須とする。\n依頼オーダ番号だけでは検査項目を一意に識別できないため、依頼オーダ番号に検査項目を識別する情報（HL7 v2 の OBR-4「検査項目ID」、OBX-3「検査項目」に相当）を組み合わせた識別子を設定する。組み立て方は JP_Observation_LabResult の identifier の生成規則を参考にすること。" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.basedOn" ] ;
       fhir:path [ fhir:v "ServiceRequest.basedOn" ] ;
       fhir:short [ fhir:v "このリクエストの元になるリクエストへの参照【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】JP Core では、個別検査項目と依頼単位（追加予定の JP_ServiceRequest_OrderRequesting）との関係付けに basedOn を使用するか否かを規定しない。\n参考（informative）：個別仕様で関係付ける場合、子（本プロファイル）の basedOn から親（依頼単位）を参照する片方向の参照が FHIR での一般的な表現である。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.requisition" ] ;
       fhir:path [ fhir:v "ServiceRequest.requisition" ] ;
       fhir:short [ fhir:v "サービスリクエストの複合ID（別名 グループID）【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】JP Core では、個別検査項目と依頼単位との関係付けに requisition を使用するか否かを規定しない。関係付けの方法は、本プロファイルを継承する個別仕様で定義する。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.status" ] ;
       fhir:path [ fhir:v "ServiceRequest.status" ] ;
       fhir:short [ fhir:v "オーダの状態【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】依頼が確定し検査を実施すべき状態では active を設定する。依頼が取り消された場合は revoked、検査が完了した場合は completed を設定する。\n(draft | active | on-hold | revoked | completed | entered-in-error | unknown)" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.intent" ] ;
       fhir:path [ fhir:v "ServiceRequest.intent" ] ;
       fhir:short [ fhir:v "サービスリクエストの意図（order 固定）【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】このプロファイルでは order に固定する。\nintent はオーダの種類を表す要素であり、依頼単位と個別検査項目の親子を区別するためには使用しない。" ] ;
       fhir:pattern [
         a fhir:Code ;
         fhir:v "order"
       ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.category" ] ;
       fhir:path [ fhir:v "ServiceRequest.category" ] ;
       fhir:short [ fhir:v "検査の区分【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】検体検査であることを示す区分を設定する。使用するコード表は個別仕様で定めてよい。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.priority" ] ;
       fhir:path [ fhir:v "ServiceRequest.priority" ] ;
       fhir:short [ fhir:v "緊急度（routine | urgent | asap | stat）【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】値セット（RequestPriority）は required であり、値は変更できない。日本の運用との対応は次を目安とする。\n・routine：通常\n・urgent：至急\n・stat：緊急（最優先で実施する）\n・asap：urgent より優先し、stat ほどではない依頼。日本の運用で該当する区分がない場合は使用しなくてよい。\n省略した場合は routine とみなす。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.code" ] ;
       fhir:path [ fhir:v "ServiceRequest.code" ] ;
       fhir:short [ fhir:v "検査項目のコード【詳細参照】" ] ;
       fhir:definition [ fhir:v "依頼された個別の検査項目を識別するコード。" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】このプロファイルでは必須とする。\n標準コードとして JLAC10（または JLAC11）を使用する。結果として返される Observation（JP_Observation_LabResult）の code と同じコード体系を使用すると、依頼と結果の突合が容易になる。" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.code.id" ] ;
       fhir:path [ fhir:v "ServiceRequest.code.id" ] ;
       fhir:short [ fhir:v "要素間参照のための一意なID" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.code.extension" ] ;
       fhir:path [ fhir:v "ServiceRequest.code.extension" ] ;
       fhir:short [ fhir:v "実装によって定義される追加コンテンツ" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.code.coding" ] ;
       fhir:path [ fhir:v "ServiceRequest.code.coding" ] ;
       fhir:short [ fhir:v "検査項目のコード（標準コード、ローカルコード）【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】標準コードとローカルコードの両方を設定できる。いずれか一方は設定すること。JLAC10 と JLAC11 など複数の標準コードを設定できるよう、上限は設けない。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.code.text" ] ;
       fhir:path [ fhir:v "ServiceRequest.code.text" ] ;
       fhir:short [ fhir:v "検査項目の名称" ] ;
       fhir:definition [ fhir:v "検査項目の表示名。オーダ票や報告書に記載する名称。" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】このプロファイルでは必須とする。\n標準コードとローカルコードで coding.display が異なる場合があるため、共通の表示名として設定する。" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.subject" ] ;
       fhir:path [ fhir:v "ServiceRequest.subject" ] ;
       fhir:short [ fhir:v "検査の対象患者【詳細参照】" ] ;
       fhir:definition [ fhir:v "オーダの対象となる患者。" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】このプロファイルでは、Patient に限定し、必須とする。" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Reference"^^xsd:anyURI ;
           fhir:l fhir:Reference
         ] ;
         fhir:targetProfile ( [
           fhir:v "http://jpfhir.jp/fhir/core/StructureDefinition/JP_Patient"^^xsd:anyURI ;
           fhir:l <http://jpfhir.jp/fhir/core/StructureDefinition/JP_Patient>
         ] )
       ] )
     ] [
       fhir:id [ fhir:v "ServiceRequest.encounter" ] ;
       fhir:path [ fhir:v "ServiceRequest.encounter" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】入院・外来の区別、所在場所、担当診療科の情報に使用する。\n通常は設定されるが、ユースケースにより使用しない場合を考慮し、必須としない。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.occurrence[x]" ] ;
       fhir:path [ fhir:v "ServiceRequest.occurrence[x]" ] ;
       fhir:short [ fhir:v "検体採取の予定日時【詳細参照】" ] ;
       fhir:definition [ fhir:v "依頼された検査を実施すべき日時または期間。" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】検体採取の予定日時を設定する。予定日が決まっていない場合は設定せず、決まった時点で更新する。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.requester" ] ;
       fhir:path [ fhir:v "ServiceRequest.requester" ] ;
       fhir:short [ fhir:v "依頼者【詳細参照】" ] ;
       fhir:definition [ fhir:v "オーダを発行した依頼者（オーダ発行者）。" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】依頼単位を分解して個別検査項目として送信する場合は、依頼単位と同じ依頼者を設定する。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.performerType" ] ;
       fhir:path [ fhir:v "ServiceRequest.performerType" ] ;
       fhir:short [ fhir:v "実施部門・職種【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】検査を実施する部門（検体検査部門、外注検査など）や職種を設定する。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.specimen" ] ;
       fhir:path [ fhir:v "ServiceRequest.specimen" ] ;
       fhir:short [ fhir:v "検体【詳細参照】" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】採取済みの検体に対して依頼する場合に、その検体（JP_Specimen_Common）を参照する。\n依頼時点で検体が未採取の場合は設定せず、Specimen リソース側から ServiceRequest を参照する。" ]
     ] [
       fhir:id [ fhir:v "ServiceRequest.bodySite" ] ;
       fhir:path [ fhir:v "ServiceRequest.bodySite" ] ;
       fhir:comment [ fhir:v "【JP Core仕様】検体検査では、JLAC10 の材料コードなど code に検体や部位が含まれることが多いため、通常は使用しない。code から部位が分からない場合にのみ使用する。" ]
     ] )
  ] . # 

