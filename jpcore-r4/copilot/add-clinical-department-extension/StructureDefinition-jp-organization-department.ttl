       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v "Organization(classCode=ORG, determinerCode=INST)" ]
       ] [
         fhir:identity [ fhir:v "servd" ] ;
         fhir:map [ fhir:v "Organization" ]
       ] )
     ] [
       fhir:id [ fhir:v "Organization.id" ] ;
