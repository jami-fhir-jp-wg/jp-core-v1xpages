       fhir:id [ fhir:v "Organization.identifier" ] ;
       fhir:path [ fhir:v "Organization.identifier" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "system" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:short [ fhir:v "診療科の識別子 【詳細参照】" ] ;
       fhir:definition [ fhir:v "診療科を識別するための識別子。" ] ;
       fhir:comment [ fhir:v "診療科の識別子は以下の2つのパターンで指定できる。\n1. 医療機関固有の診療科コード（ローカルコード）\n   - system: http://jpfhir.jp/fhir/core/mhlw/CodeSystem/MedicationRequestDepartment/{医療機関識別OID番号}\n   - 医療機関識別OID番号は、医療機関コード（10桁）の先頭に1をつけた11桁とする\n   - 例：医療機関コード「1312345670」の場合「http://jpfhir.jp/fhir/core/mhlw/CodeSystem/MedicationRequestDepartment/11312345670」\n2. SS-MIX2標準診療科コード（ssmixDepartmentCodeスライス）\n   - system: http://jami.jp/SS-MIX2/CodeSystem/ClinicalDepartment\n   - SS-MIX2で定義された診療科コードを使用" ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "jp-org-dept-identifier-local-system" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "ローカル診療科コードのsystemは 'http://jpfhir.jp/fhir/core/mhlw/CodeSystem/MedicationRequestDepartment/[1+施設番号10桁]'でなければならない。" ] ;
         fhir:expression [ fhir:v "system.all(substring(0,43)!='http://jpfhir.jp/fhir/core/mhlw/CodeSystem/MedicationRequestDepartment/' or substring(43).matches('^1(0[1-9]|[1-3][0-9]|4[0-7])([0-9])([0-9]{7})$'))" ] ;
         fhir:source [
           fhir:v "http://jpfhir.jp/fhir/core/StructureDefinition/JP_Organization_Department"^^xsd:anyURI ;
           fhir:l <http://jpfhir.jp/fhir/core/StructureDefinition/JP_Organization_Department>
         ]
       ] )
     ] [
       fhir:id [ fhir:v "Organization.identifier:ssmixDepartmentCode" ] ;
       fhir:path [ fhir:v "Organization.identifier" ] ;
       fhir:sliceName [ fhir:v "ssmixDepartmentCode" ] ;
       fhir:short [ fhir:v "SS-MIX2標準診療科コード" ] ;
       fhir:definition [ fhir:v "SS-MIX2で定義された標準診療科コード。" ] ;
       fhir:comment [ fhir:v "SS-MIX2に準拠した診療科コードを指定する場合に使用する。" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ]
     ] [
       fhir:id [ fhir:v "Organization.identifier:ssmixDepartmentCode.system" ] ;
       fhir:path [ fhir:v "Organization.identifier.system" ] ;
       fhir:short [ fhir:v "SS-MIX2診療科コード体系のURI" ] ;
       fhir:definition [ fhir:v "SS-MIX2で定義された診療科コード体系を示すURI。" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:fixed [
         a fhir:Uri ;
         fhir:v "http://jami.jp/SS-MIX2/CodeSystem/ClinicalDepartment"^^xsd:anyURI ;
         fhir:l <http://jami.jp/SS-MIX2/CodeSystem/ClinicalDepartment>
       ]
     ] [
       fhir:id [ fhir:v "Organization.identifier:ssmixDepartmentCode.value" ] ;
       fhir:path [ fhir:v "Organization.identifier.value" ] ;
       fhir:short [ fhir:v "SS-MIX2診療科コードの値" ] ;
       fhir:definition [ fhir:v "SS-MIX2で定義された診療科コードの値。" ] ;
       fhir:comment [ fhir:v "SS-MIX2標準診療科コードの値を設定する（例：01=内科、02=精神科など）。" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Organization.type" ] ;
       fhir:path [ fhir:v "Organization.type" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Organization.type:departmentType" ] ;
       fhir:path [ fhir:v "Organization.type" ] ;
       fhir:sliceName [ fhir:v "departmentType" ] ;
       fhir:short [ fhir:v "診療科・部門を示す組織タイプ" ] ;
       fhir:definition [ fhir:v "この組織が診療科・部門であることを示すコード。固定値でdept（部門）を設定する。" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:CodeableConcept ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://terminology.hl7.org/CodeSystem/organization-type"^^xsd:anyURI ;
             fhir:l <http://terminology.hl7.org/CodeSystem/organization-type>
           ] ;
           fhir:code [ fhir:v "dept" ]
         ] )
       ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/organization-type"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/ValueSet/organization-type>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Organization.partOf" ] ;
       fhir:path [ fhir:v "Organization.partOf" ] ;
       fhir:short [ fhir:v "所属する医療機関" ] ;
       fhir:definition [ fhir:v "この診療科が所属する上位組織（医療機関）への参照" ] ;
       fhir:comment [ fhir:v "診療科は通常、医療機関に所属するため、partOf要素で親組織を参照することが推奨される。" ] ;
       fhir:type ( [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/structuredefinition-hierarchy"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-hierarchy>
           ] ;
           fhir:value [
             a fhir:Boolean ;
             fhir:v true
           ]
         ] ) ;
         fhir:code [
           fhir:v "Reference"^^xsd:anyURI ;
           fhir:l fhir:Reference
         ] ;
         fhir:targetProfile ( [
           fhir:v "http://jpfhir.jp/fhir/core/StructureDefinition/JP_Organization"^^xsd:anyURI ;
           fhir:l <http://jpfhir.jp/fhir/core/StructureDefinition/JP_Organization>
         ] )
       ] )
     ] )
  ] . # 

