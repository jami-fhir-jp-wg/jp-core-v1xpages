     fhir:code [ fhir:v "TM-10-01" ] ;
     fhir:display [ fhir:v "骨瘤（唇側・頬側）（Ｔｏｒ）" ]
  ] [
     fhir:code [ fhir:v "TM-10-02" ] ;
     fhir:display [ fhir:v "骨瘤（舌側・口蓋側）（Ｔｏｒ）" ]
  ] [
     fhir:code [ fhir:v "TM-10-03" ] ;
     fhir:display [ fhir:v "骨瘤（唇側・頬側および舌側・口蓋側）（Ｔｏｒ）" ]
  ] [
     fhir:code [ fhir:v "TM-10-04" ] ;
     fhir:display [ fhir:v "骨瘤（側不明）（Ｔｏｒ）" ]
  ] [
     fhir:code [ fhir:v "TM-11-01" ] ;
     fhir:display [ fhir:v "アタッチメント（磁性：磁石構造体など）" ]
  ] [
     fhir:code [ fhir:v "TM-11-02" ] ;
     fhir:display [ fhir:v "アタッチメント（バー：スリーブなど）" ]
  ] [
     fhir:code [ fhir:v "TM-11-03" ] ;
     fhir:display [ fhir:v "アタッチメント（その他）" ]
  ] ) . # 

